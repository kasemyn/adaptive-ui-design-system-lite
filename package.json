{
  "name": "@fc/adaptive-ui",
  "version": "0.2.0",
  "description": "Adaptive design system for foldables, tablets, dual-screen and desktop-windowed React Native apps",
  "main": "./lib/commonjs/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "adaptive-ui-source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./navigation": {
      "adaptive-ui-source": "./src/navigation/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/navigation/index.d.ts",
        "default": "./lib/module/navigation/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/navigation/index.d.ts",
        "default": "./lib/commonjs/navigation/index.js"
      }
    },
    "./testing": {
      "adaptive-ui-source": "./src/testing/index.tsx",
      "import": {
        "types": "./lib/typescript/module/src/testing/index.d.ts",
        "default": "./lib/module/testing/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/testing/index.d.ts",
        "default": "./lib/commonjs/testing/index.js"
      }
    },
    "./jest-setup": "./jest-setup.js",
    "./eslint": "./eslint.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "bin",
    "navigation",
    "testing",
    "eslint.js",
    "jest-setup.js",
    "!**/__tests__",
    "!android/build"
  ],
  "scripts": {
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin eslint.js jest-setup.js"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7.4.0",
    "@react-navigation/native": ">=7.0.0",
    "@testing-library/react-native": ">=13.3.0",
    "react": "*",
    "react-native": ">=0.76.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/bottom-tabs": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "@testing-library/react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AdaptiveFoldSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.fc.adaptiveui"
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "bin": {
    "adaptive-ui": "./bin/adaptive-ui.js"
  }
}
